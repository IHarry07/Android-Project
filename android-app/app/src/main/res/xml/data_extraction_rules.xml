<?xml version="1.0" encoding="utf-8"?>
<!-- 안드로이드 12 이상의 자동 백업·기기 이전 규칙. 화면 모드·글자 크기 같은 설정만 옮겨진다. -->
<data-extraction-rules>
    <cloud-backup>
        <!-- 로그인 정보와 푸시·알림 기기 정보는 백업·기기 이전에서 뺀다. (새 폰에서는 다시 로그인) -->
        <exclude domain="sharedpref" path="roomade_token.xml" />
        <exclude domain="sharedpref" path="roomade_push.xml" />
        <exclude domain="sharedpref" path="roomade_notification.xml" />
        <exclude domain="sharedpref" path="roomade_prompts.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- 로그인 정보와 푸시·알림 기기 정보는 백업·기기 이전에서 뺀다. (새 폰에서는 다시 로그인) -->
        <exclude domain="sharedpref" path="roomade_token.xml" />
        <exclude domain="sharedpref" path="roomade_push.xml" />
        <exclude domain="sharedpref" path="roomade_notification.xml" />
        <exclude domain="sharedpref" path="roomade_prompts.xml" />
    </device-transfer>
</data-extraction-rules>