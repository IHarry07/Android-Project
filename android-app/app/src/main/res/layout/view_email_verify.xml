<?xml version="1.0" encoding="utf-8"?>
<!-- 이메일 인증 (가입, 이메일 등록·변경에서 같이 쓴다) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etVerifyEmail"
            style="@style/Rm.Input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="example@email.com"
            android:inputType="textEmailAddress"
            android:maxLength="100"
            android:maxLines="1" />

        <Button
            android:id="@+id/btnSendEmailCode"
            style="@style/Rm.Button.Outline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="인증번호 받기"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutEmailCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <EditText
            android:id="@+id/etEmailCode"
            style="@style/Rm.Input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="인증번호 6자리"
            android:inputType="number"
            android:maxLength="6"
            android:maxLines="1" />

        <Button
            android:id="@+id/btnVerifyEmailCode"
            style="@style/Rm.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="확인"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvEmailVerifyStatus"
        style="@style/Rm.Helper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="비밀번호를 잊었을 때 이 이메일로 찾을 수 있어요. 인증번호로 본인 주소인지 확인해요." />
</LinearLayout>