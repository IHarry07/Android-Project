<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rm_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="뒤로"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/tvFormTitle"
            style="@style/Rm.TopTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="일정 추가" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- 공유 / 개인 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_tint"
                android:orientation="horizontal"
                android:padding="6dp">

                <TextView
                    android:id="@+id/tabShared"
                    style="@style/Rm.Segment"
                    android:text="공유 일정" />

                <TextView
                    android:id="@+id/tabPersonal"
                    style="@style/Rm.Segment"
                    android:text="개인 일정" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvVisibilityHint"
                style="@style/Rm.Helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                style="@style/Rm.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="제목" />

            <EditText
                android:id="@+id/etScheduleTitle"
                style="@style/Rm.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="예: 함께 이야기하기"
                android:inputType="text"
                android:maxLength="150"
                android:maxLines="1" />

            <TextView
                style="@style/Rm.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="시작" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStartDate"
                    style="@style/Rm.Input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical" />

                <TextView
                    android:id="@+id/tvStartTime"
                    style="@style/Rm.Input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="2"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical" />
            </LinearLayout>

            <TextView
                style="@style/Rm.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="종료" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvEndDate"
                    style="@style/Rm.Input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical" />

                <TextView
                    android:id="@+id/tvEndTime"
                    style="@style/Rm.Input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="2"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Rm.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="내용" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="선택"
                    android:textColor="@color/rm_sub"
                    android:textSize="13sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etScheduleDescription"
                style="@style/Rm.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_multiline"
                android:gravity="top|start"
                android:hint="준비물이나 메모를 적어 보세요. (500자 이내)"
                android:inputType="textMultiLine"
                android:maxLength="500"
                android:minHeight="112dp" />

            <!-- 알림 시간: 시작 몇 분 전에 알릴지 -->
            <TextView
                style="@style/Rm.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="알림" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutReminderChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/layoutReminderCustom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etReminderValue"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_field_small"
                    android:gravity="center"
                    android:hint="숫자"
                    android:inputType="number"
                    android:maxLength="5"
                    android:maxLines="1"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textColor="@color/rm_title"
                    android:textColorHint="@color/rm_hint"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/layoutReminderUnits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvReminderHint"
                style="@style/Rm.Helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnSaveSchedule"
                style="@style/Rm.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="추가하기" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
