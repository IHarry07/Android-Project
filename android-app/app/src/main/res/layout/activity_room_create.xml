<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rm_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 상단 바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="뒤로"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Rm.TopTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tvScreenTitle"
            android:text="방 만들기" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="32dp"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/tvIntroTitle"
                style="@style/Rm.H1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="새로운 방을 만들어 보세요" />

            <TextView
                android:id="@+id/tvIntroSub"
                style="@style/Rm.Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="이름을 정하고 함께할 사람들을 초대하세요." />

            <!-- 방 이름 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Rm.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="방 이름" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="필수"
                    android:textColor="@color/rm_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <EditText
                    android:id="@+id/etRoomName"
                    style="@style/Rm.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="우리의 방"
                    android:inputType="text"
                    android:maxLength="20"
                    android:maxLines="1"
                    android:paddingEnd="80dp" />

                <TextView
                    android:id="@+id/tvNameCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="20dp"
                    android:text="0 / 20"
                    android:textColor="@color/rm_sub"
                    android:textSize="14sp" />
            </FrameLayout>

            <TextView
                style="@style/Rm.Helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="누구나 알아보기 쉬운 이름으로 정해 주세요." />

            <!-- 방 소개 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Rm.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="방 소개" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="선택"
                    android:textColor="@color/rm_sub"
                    android:textSize="13sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <EditText
                    android:id="@+id/etRoomDescription"
                    style="@style/Rm.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_multiline"
                    android:gravity="top|start"
                    android:hint="어떤 방인지 짧게 소개해 주세요."
                    android:inputType="textMultiLine"
                    android:maxLength="100"
                    android:minHeight="128dp"
                    android:paddingBottom="40dp" />

                <TextView
                    android:id="@+id/tvDescCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|bottom"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="14dp"
                    android:text="0 / 100"
                    android:textColor="@color/rm_sub"
                    android:textSize="14sp" />
            </FrameLayout>

            <!-- 최대 인원 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Rm.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="최대 인원" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="선택"
                    android:textColor="@color/rm_sub"
                    android:textSize="13sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etCapacity"
                style="@style/Rm.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="비워 두면 10명"
                android:inputType="number"
                android:maxLength="2"
                android:maxLines="1" />

            <TextView
                style="@style/Rm.Helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="2명에서 10명까지 정할 수 있어요." />

            <!-- 안내 카드 -->
            <LinearLayout
                android:id="@+id/cardInviteInfo"
                style="@style/Rm.TintCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="초대 코드로 함께해요"
                    android:textColor="@color/rm_title"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Rm.Sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.2"
                    android:text="방을 만들면 초대 코드가 발급돼요. 코드를 공유해 사람들을 초대할 수 있어요." />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnCreateRoom"
                style="@style/Rm.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="방 만들기" />

            <TextView
                android:id="@+id/tvTailHelper"
                style="@style/Rm.Helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="방 정보는 만든 후에도 수정할 수 있어요." />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
