<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rm_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="뒤로"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Rm.TopTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="내 정보" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- 아이디 (바꿀 수 없음) -->
            <TextView
                style="@style/Rm.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="아이디" />

            <TextView
                android:id="@+id/tvLoginId"
                style="@style/Rm.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_tint"
                android:gravity="center_vertical"
                android:textColor="@color/rm_sub" />

            <!-- 이름 -->
            <TextView
                style="@style/Rm.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="이름" />

            <EditText
                android:id="@+id/etMyName"
                style="@style/Rm.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:inputType="textPersonName"
                android:maxLength="50"
                android:maxLines="1" />

            <!-- 닉네임 -->
            <TextView
                style="@style/Rm.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="닉네임" />

            <EditText
                android:id="@+id/etMyNickname"
                style="@style/Rm.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:inputType="text"
                android:maxLength="20"
                android:maxLines="1" />

            <TextView
                style="@style/Rm.Helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="한글, 영문, 숫자, 밑줄(_)로 2~20자" />

            <!-- 전화번호 -->
            <TextView
                style="@style/Rm.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="전화번호" />

            <EditText
                android:id="@+id/etMyPhone"
                style="@style/Rm.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:inputType="phone"
                android:maxLength="20"
                android:maxLines="1" />

            <!-- 이메일 (선택) -->
            <TextView
                style="@style/Rm.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="이메일 (선택)" />

            <EditText
                android:id="@+id/etMyEmail"
                style="@style/Rm.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="비밀번호를 잊었을 때 이메일로 찾을 수 있어요"
                android:inputType="textEmailAddress"
                android:maxLength="100"
                android:maxLines="1" />

            <Button
                android:id="@+id/btnSaveMyInfo"
                style="@style/Rm.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="저장하기" />

            <!-- 바꿀 수 없는 정보 -->
            <TextView
                style="@style/Rm.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="생년월일 · 성별" />

            <TextView
                android:id="@+id/tvBirthGender"
                style="@style/Rm.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_tint"
                android:gravity="center_vertical"
                android:textColor="@color/rm_sub" />

            <TextView
                style="@style/Rm.Helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="생년월일과 성별은 바꿀 수 없어요." />

            <!-- 계좌 -->
            <TextView
                style="@style/Rm.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="계좌 정보" />

            <TextView
                android:id="@+id/tvAccount"
                style="@style/Rm.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_tint"
                android:gravity="center_vertical"
                android:textColor="@color/rm_sub" />

            <Button
                android:id="@+id/btnChangeAccount"
                style="@style/Rm.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="계좌 변경" />

            <!-- 비밀번호 -->
            <Button
                android:id="@+id/btnChangePassword"
                style="@style/Rm.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="비밀번호 변경" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
