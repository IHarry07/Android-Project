<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rm_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="뒤로"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Rm.TopTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="냉장고" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvFridgeRoom"
                style="@style/Rm.Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- 내 음식 / 공용 음식 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_tint"
                android:orientation="horizontal"
                android:padding="6dp">

                <TextView
                    android:id="@+id/tabMine"
                    style="@style/Rm.Segment"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="내 음식"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tabShared"
                    style="@style/Rm.Segment"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="공용 음식"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tabOthers"
                    style="@style/Rm.Segment"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="구성원 음식"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                style="@style/Rm.TintCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvBannerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rm_title"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBannerSub"
                    style="@style/Rm.Sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvListTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:textColor="@color/rm_title"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFridgeEmpty"
                style="@style/Rm.Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="32dp"
                android:paddingBottom="32dp"
                android:text="아직 등록한 음식이 없어요."
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFridge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnAddFood"
                style="@style/Rm.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/tvAddHint"
                style="@style/Rm.Helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
