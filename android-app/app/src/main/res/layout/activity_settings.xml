<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rm_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="뒤로"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Rm.TopTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="설정" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowNotification"
                    style="@style/Rm.MenuRow">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_bell"
                        app:tint="@color/rm_primary" />

                    <TextView
                        style="@style/Rm.MenuLabel"
                        android:text="알림 설정" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/rm_sub" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@color/rm_border" />

                <LinearLayout
                    style="@style/Rm.MenuRow"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Rm.MenuLabel"
                            android:layout_width="wrap_content"
                            android:layout_weight="0"
                            android:layout_marginStart="0dp"
                            android:text="프로필 사진 공개" />

                        <TextView
                            style="@style/Rm.Helper"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="끄면 같은 방 사람들에게 내 사진이 보이지 않아요." />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swPhotoPublic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:enabled="false" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@color/rm_border" />

                <LinearLayout
                    android:id="@+id/rowTheme"
                    style="@style/Rm.MenuRow">

                    <TextView
                        style="@style/Rm.MenuLabel"
                        android:layout_marginStart="0dp"
                        android:text="화면 모드" />

                    <TextView
                        android:id="@+id/tvThemeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:textColor="@color/rm_sub"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/rm_sub" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@color/rm_border" />

                <LinearLayout
                    android:id="@+id/rowFont"
                    style="@style/Rm.MenuRow">

                    <TextView
                        style="@style/Rm.MenuLabel"
                        android:layout_marginStart="0dp"
                        android:text="글자 크기" />

                    <TextView
                        android:id="@+id/tvFontValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:textColor="@color/rm_sub"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/rm_sub" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@color/rm_border" />

                <LinearLayout
                    style="@style/Rm.MenuRow"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Rm.MenuLabel"
                            android:layout_width="wrap_content"
                            android:layout_weight="0"
                            android:layout_marginStart="0dp"
                            android:text="반복 청소 날짜 계속 표시" />

                        <TextView
                            style="@style/Rm.Helper"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="끄면 캘린더에는 다음 예정일만 보여요." />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swRepeatCleaning"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@color/rm_border" />

                <LinearLayout
                    android:id="@+id/rowTerms"
                    style="@style/Rm.MenuRow">

                    <TextView
                        style="@style/Rm.MenuLabel"
                        android:layout_marginStart="0dp"
                        android:text="이용약관" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/rm_sub" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@color/rm_border" />

                <LinearLayout
                    android:id="@+id/rowPrivacy"
                    style="@style/Rm.MenuRow">

                    <TextView
                        style="@style/Rm.MenuLabel"
                        android:layout_marginStart="0dp"
                        android:text="개인정보 처리방침" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/rm_sub" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@color/rm_border" />
                <LinearLayout
                    android:id="@+id/rowNotices"
                    style="@style/Rm.MenuRow">

                    <TextView
                        style="@style/Rm.MenuLabel"
                        android:layout_marginStart="0dp"
                        android:text="공지사항" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/rm_sub" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@color/rm_border" />
                <LinearLayout style="@style/Rm.MenuRow">

                    <TextView
                        style="@style/Rm.MenuLabel"
                        android:layout_marginStart="0dp"
                        android:text="앱 버전" />

                    <TextView
                        android:id="@+id/tvVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/rm_sub"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Rm.Helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="화면 모드와 글자 크기는 이 휴대폰에만 저장돼요." />

            <TextView
                android:id="@+id/tvWithdraw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:background="?attr/selectableItemBackground"
                android:padding="12dp"
                android:text="회원 탈퇴"
                android:textColor="@color/rm_danger"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>