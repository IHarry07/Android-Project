<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rm_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="뒤로"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/tvFormTitle"
            style="@style/Rm.TopTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- 공용 / 내 것 (추가할 때만 보인다) -->
            <LinearLayout
                android:id="@+id/layoutOwnership"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_tint"
                android:orientation="horizontal"
                android:padding="6dp">

                <TextView
                    android:id="@+id/tabShared"
                    style="@style/Rm.Segment"
                    android:text="공용" />

                <TextView
                    android:id="@+id/tabPersonal"
                    style="@style/Rm.Segment"
                    android:text="내 것" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvOwnershipHint"
                style="@style/Rm.Helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- QR로 입력 (추가할 때만 보인다) -->
            <LinearLayout
                android:id="@+id/cardQr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_white"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="128dp"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_qr"
                    app:tint="@color/rm_primary" />

                <TextView
                    android:id="@+id/tvQrTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="QR 코드로 입력"
                    android:textColor="@color/rm_title"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Rm.Helper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="상품의 QR을 비추면 이름이 자동으로 채워져요" />
            </LinearLayout>

            <!-- 종류 (창고에서 추가할 때만 보인다) -->
            <LinearLayout
                android:id="@+id/layoutCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Rm.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="종류" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipSupply"
                        style="@style/Rm.Chip"
                        android:text="생활용품" />

                    <TextView
                        android:id="@+id/chipFood"
                        style="@style/Rm.Chip"
                        android:layout_marginStart="8dp"
                        android:text="식재료" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Rm.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="이름" />

            <EditText
                android:id="@+id/etItemName"
                style="@style/Rm.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="예: 두루마리 휴지"
                android:inputType="text"
                android:maxLength="100"
                android:maxLines="1" />

            <TextView
                style="@style/Rm.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="수량과 단위" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etItemQuantity"
                    style="@style/Rm.Input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="1"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:text="1" />

                <EditText
                    android:id="@+id/etItemUnit"
                    style="@style/Rm.Input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:hint="개, 롤, ml"
                    android:inputType="text"
                    android:maxLength="20"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Rm.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="유통기한" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="선택"
                    android:textColor="@color/rm_sub"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvItemExpiry"
                style="@style/Rm.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:text="날짜 선택"
                android:textColor="@color/rm_hint" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Rm.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="보관 위치" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="선택"
                    android:textColor="@color/rm_sub"
                    android:textSize="13sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etItemLocation"
                style="@style/Rm.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="예: 욕실 선반, 냉장"
                android:inputType="text"
                android:maxLength="50"
                android:maxLines="1" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnSaveItem"
                style="@style/Rm.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="추가하기" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
