<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rm_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="뒤로"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Rm.TopTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="비밀번호 찾기" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 1단계: 가입 정보 확인 -->
            <LinearLayout
                android:id="@+id/layoutStep1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 / 2 단계"
                    android:textColor="@color/rm_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Rm.H1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="가입 정보를 확인할게요" />

                <TextView
                    style="@style/Rm.Sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingMultiplier="1.2"
                    android:text="가입할 때 입력한 정보가 모두 맞으면 새 비밀번호를 정할 수 있어요." />

                <TextView
                    style="@style/Rm.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="아이디" />

                <EditText
                    android:id="@+id/etResetLoginId"
                    style="@style/Rm.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="아이디를 입력해 주세요"
                    android:inputType="text"
                    android:maxLines="1" />

                <TextView
                    style="@style/Rm.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="이름" />

                <EditText
                    android:id="@+id/etResetName"
                    style="@style/Rm.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="이름을 입력해 주세요"
                    android:inputType="textPersonName"
                    android:maxLines="1" />

                <TextView
                    style="@style/Rm.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="전화번호" />

                <EditText
                    android:id="@+id/etResetPhone"
                    style="@style/Rm.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="예: 010-1234-5678"
                    android:inputType="phone"
                    android:maxLines="1" />

                <TextView
                    style="@style/Rm.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="생년월일" />

                <EditText
                    android:id="@+id/etResetBirthDate"
                    style="@style/Rm.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="예: 2005-01-01"
                    android:inputType="text"
                    android:maxLines="1" />

                <TextView
                    style="@style/Rm.Helper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="여러 번 틀리면 잠시 동안 시도할 수 없어요." />

                <Button
                    android:id="@+id/btnVerify"
                    style="@style/Rm.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="확인" />
            </LinearLayout>

            <!-- 2단계: 새 비밀번호 (가입 정보 확인이 끝나면 보인다) -->
            <LinearLayout
                android:id="@+id/layoutStep2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 / 2 단계"
                    android:textColor="@color/rm_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Rm.H1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="새 비밀번호를 정해 주세요" />

                <TextView
                    style="@style/Rm.Sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingMultiplier="1.2"
                    android:text="본인 확인이 끝났어요. 10분 안에 새 비밀번호를 정해 주세요." />

                <TextView
                    style="@style/Rm.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="새 비밀번호" />

                <EditText
                    android:id="@+id/etResetNewPassword"
                    style="@style/Rm.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="8자 이상, 영문+숫자"
                    android:inputType="textPassword"
                    android:maxLines="1" />

                <TextView
                    style="@style/Rm.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="새 비밀번호 확인" />

                <EditText
                    android:id="@+id/etResetNewPasswordConfirm"
                    style="@style/Rm.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="새 비밀번호를 한 번 더 입력해 주세요"
                    android:inputType="textPassword"
                    android:maxLines="1" />

                <TextView
                    style="@style/Rm.Helper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="바꾸면 다른 기기의 로그인은 모두 해제돼요." />

                <Button
                    android:id="@+id/btnResetPassword"
                    style="@style/Rm.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="비밀번호 재설정" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
