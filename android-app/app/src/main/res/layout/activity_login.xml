<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rm_bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <TextView
            style="@style/Rm.TopTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="로그인" />

        <TextView
            style="@style/Rm.H1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="함께하는 일상,\n다시 만나 반가워요" />

        <TextView
            style="@style/Rm.Sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="로그인하고 우리 방의 일상을 이어가세요." />

        <TextView
            style="@style/Rm.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="아이디" />

        <EditText
            android:id="@+id/etLoginId"
            style="@style/Rm.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="아이디를 입력해 주세요"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            style="@style/Rm.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="비밀번호" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/etPassword"
                style="@style/Rm.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="비밀번호를 입력해 주세요"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingEnd="56dp" />

            <ImageView
                android:id="@+id/ivTogglePassword"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:contentDescription="비밀번호 보기"
                android:padding="12dp"
                android:src="@drawable/ic_eye_off" />
        </FrameLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <CheckBox
                android:id="@+id/cbKeepLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                app:buttonIconTint="@color/white"
                app:buttonTint="@color/rm_primary"
                android:paddingStart="8dp"
                android:text="로그인 유지"
                android:textColor="@color/rm_sub"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"
                android:text="비밀번호를 잊으셨나요?"
                android:textColor="@color/rm_title"
                android:textSize="14sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <Button
            android:id="@+id/btnLogin"
            style="@style/Rm.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="로그인" />

        <TextView
            style="@style/Rm.Sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="아직 계정이 없으신가요?" />

        <TextView
            android:id="@+id/tvGoSignup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="12dp"
            android:text="회원가입"
            android:textColor="@color/rm_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvLegal"
            style="@style/Rm.Helper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="이용약관  ·  개인정보 처리방침" />
    </LinearLayout>
</ScrollView>
