<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rm_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="뒤로"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Rm.TopTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="청소당번 설정" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollRoot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvSettingsRoom"
                style="@style/Rm.Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- 반복 주기 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Rm.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="반복 주기"
                    android:textSize="17sp" />

                <!-- 주기가 5개라 좁은 화면에서는 옆으로 밀어서 볼 수 있다. -->
                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipDaily"
                            style="@style/Rm.Chip"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="매일" />

                        <TextView
                            android:id="@+id/chipWeekly"
                            style="@style/Rm.Chip"
                            android:layout_marginStart="8dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="매주" />

                        <TextView
                            android:id="@+id/chipBiweekly"
                            style="@style/Rm.Chip"
                            android:layout_marginStart="8dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="격주" />

                        <TextView
                            android:id="@+id/chipMonthly"
                            style="@style/Rm.Chip"
                            android:layout_marginStart="8dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="매월" />

                        <TextView
                            android:id="@+id/chipOnce"
                            style="@style/Rm.Chip"
                            android:layout_marginStart="8dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="한 번만" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- 구성원별 담당 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="구성원별 담당"
                    android:textColor="@color/rm_title"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRowSummary"
                    style="@style/Rm.Sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCleaningRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/btnAddRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="14dp"
                android:text="+  구성원 또는 담당 구역 추가"
                android:textColor="@color/rm_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 순환 (한 번만 하는 청소에는 없다) -->
            <LinearLayout
                android:id="@+id/cardRotation"
                style="@style/Rm.TintCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvRotationTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/rm_title"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchRotation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRotationHint"
                    style="@style/Rm.Sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.2"
                    android:textSize="14sp" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnSaveCleaning"
                style="@style/Rm.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="청소당번 저장" />

            <TextView
                style="@style/Rm.Helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="저장하면 방의 캘린더에 청소 일정이 표시돼요." />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
