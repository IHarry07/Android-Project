# 룸메이드 HTTPS. setup.sh 가 __DOMAIN__ 을 실제 주소로 바꿔 /etc/caddy/Caddyfile 로 넣는다.
# Caddy가 Let's Encrypt 인증서를 자동으로 받고 갱신하며, http:// 로 오면 https:// 로 넘긴다.
__DOMAIN__ {
	encode gzip
	# 사진 업로드(최대 수 MB)보다 넉넉하게
	request_body {
		max_size 10MB
	}
	reverse_proxy 127.0.0.1:3000
	log {
		output file /var/log/caddy/roomade-access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
