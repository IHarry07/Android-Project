[Unit]
Description=RoomMade API server
After=network-online.target mysql.service
Wants=network-online.target
Requires=mysql.service

[Service]
Type=simple
User=roomade
Group=roomade
WorkingDirectory=/opt/roomade/backend
Environment=NODE_ENV=production
Environment=TZ=Asia/Seoul
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
# 보안: 다른 권한을 얻지 못하게 하고, 시스템 파일은 읽기 전용으로
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
