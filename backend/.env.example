# 이 파일을 .env로 복사해서 값을 채운다. .env는 GitHub에 올리지 않는다.
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=roomade
# 로그인 토큰 서명 키. 48바이트 이상 난수의 16진수 문자열을 쓴다.
# 만드는 법: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# 계좌 정보 암호화 키. 정확히 32바이트(64자리 16진수)여야 한다. 키를 잃어버리면 저장된 계좌 정보를 복호화할 수 없다.
# 만드는 법: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCOUNT_ENC_KEY=