# 이 파일을 .env로 복사해서 값을 채운다. .env는 GitHub에 올리지 않는다.
PORT=3000
# (배포) 서버가 받을 주소. HTTPS 프록시(Caddy) 뒤에서는 127.0.0.1, 비우면 모든 주소(같은 와이파이의 폰이 직접 접속)
HOST=
# (배포) HTTPS 프록시를 믿을지. 같은 서버의 Caddy 뒤면 loopback. 비우면 믿지 않는다. (요청 수 제한을 실제 IP 기준으로)
TRUST_PROXY=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=roomade
# 로그인 토큰 서명 키. 48바이트 이상 난수의 16진수 문자열을 쓴다.
# 만드는 법: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# 계좌 정보 암호화 키. 정확히 32바이트(64자리 16진수)여야 한다. 키를 잃어버리면 저장된 계좌 정보를 복호화할 수 없다.
# 만드는 법: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCOUNT_ENC_KEY=
# (선택) 푸시 알림(FCM). Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 JSON 파일의 경로. 비우면 푸시 없이 앱 안 알림만 동작한다.
# 이 파일은 GitHub에 올리지 않는다.
FIREBASE_SERVICE_ACCOUNT=

# (선택) 이메일로 비밀번호 찾기용 메일 발송 설정. 비우면 '이메일 인증은 준비 중'으로 안내한다.
# Gmail 예: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<계정>, SMTP_PASSWORD=<앱 비밀번호>, MAIL_FROM=룸메이드 <계정>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# 로그인한 회원 한 명이 1분에 보낼 수 있는 요청 수 (기본 120)
USER_RATE_LIMIT_PER_MINUTE=120
# 개발용: 메일 설정이 없을 때 인증번호를 서버 콘솔에 출력 (배포에서는 false)
MAIL_DEV_CONSOLE=false
# 서버 전용 DB 계정을 쓰려면 DB_USER=roomade_app (scripts/create-db-app-user.js 참고)
# 그때 관리자 계정(root)은 backend/.env.admin 에 둔다. 마이그레이션·백업·테스트가 이 계정을 쓴다. (.env.admin.example 참고)
# .env.admin 이 없으면 위 DB_USER 를 그대로 쓰므로, 개발 PC에서 root로만 돌릴 때는 만들지 않아도 된다.
